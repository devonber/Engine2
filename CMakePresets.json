{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}"
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "architecture": { "value": "x64", "strategy": "external" },
      "toolset": { "value": "host=x64", "strategy": "external" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": { "hostOS": [ "Windows" ] }
      }
    },
    {
      "name": "msvc-base",
      "hidden": true,
      "inherits": "windows-base",
      "cacheVariables": { "CMAKE_C_COMPILER": "cl.exe", "CMAKE_CXX_COMPILER": "cl.exe" }
    },
    {
      "name": "clangcl-base",
      "hidden": true,
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl.exe", "CMAKE_CXX_COMPILER": "clang-cl.exe",
        "CMAKE_LINKER": "lld-link.exe",
        "CMAKE_AR": "llvm-lib.exe"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "hostOS": [ "Windows" ],
          "intelliSenseMode": "windows-clang-x64"
        }
      }
    },
    {
      "name": "msvc-debug",
      "displayName": "MSVC Debug",
      "description": "No optimisation, asserts on. For stepping through code.",
      "inherits": "msvc-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "msvc-release",
      "displayName": "MSVC Release",
      "description": "Full optimisation + LTO. What ships.",
      "inherits": "msvc-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "msvc-profile",
      "displayName": "MSVC Profile (Tracy)",
      "description": "Release code generation + debug symbols + Tracy profiler client.",
      "inherits": "msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "ENGINE_ENABLE_TRACY": "ON"
      }
    },
    {
      "name": "msvc-asan",
      "displayName": "MSVC Debug + AddressSanitizer",
      "inherits": "msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENGINE_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "clangcl-release",
      "displayName": "clang-cl Release",
      "description": "Second optimiser to compare codegen against MSVC. Needs the 'C++ Clang tools for Windows' VS component.",
      "inherits": "clangcl-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "linux-gcc-debug",
      "displayName": "GCC Debug",
      "inherits": "linux-base",
      "cacheVariables": { "CMAKE_C_COMPILER": "gcc", "CMAKE_CXX_COMPILER": "g++", "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "linux-gcc-release",
      "displayName": "GCC Release",
      "inherits": "linux-base",
      "cacheVariables": { "CMAKE_C_COMPILER": "gcc", "CMAKE_CXX_COMPILER": "g++", "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "linux-clang-release",
      "displayName": "Clang Release",
      "inherits": "linux-base",
      "cacheVariables": { "CMAKE_C_COMPILER": "clang", "CMAKE_CXX_COMPILER": "clang++", "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "linux-gcc-asan",
      "displayName": "GCC Debug + ASan/UBSan",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc", "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_BUILD_TYPE": "Debug",
        "ENGINE_ENABLE_SANITIZERS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "msvc-debug",          "configurePreset": "msvc-debug" },
    { "name": "msvc-release",        "configurePreset": "msvc-release" },
    { "name": "msvc-profile",        "configurePreset": "msvc-profile" },
    { "name": "msvc-asan",           "configurePreset": "msvc-asan" },
    { "name": "clangcl-release",     "configurePreset": "clangcl-release" },
    { "name": "linux-gcc-debug",     "configurePreset": "linux-gcc-debug" },
    { "name": "linux-gcc-release",   "configurePreset": "linux-gcc-release" },
    { "name": "linux-clang-release", "configurePreset": "linux-clang-release" },
    { "name": "linux-gcc-asan",    "configurePreset": "linux-gcc-asan" }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    },
    { "name": "msvc-debug",          "inherits": "test-base", "configurePreset": "msvc-debug" },
    { "name": "msvc-release",        "inherits": "test-base", "configurePreset": "msvc-release" },
    { "name": "msvc-asan",           "inherits": "test-base", "configurePreset": "msvc-asan" },
    { "name": "clangcl-release",     "inherits": "test-base", "configurePreset": "clangcl-release" },
    { "name": "linux-gcc-debug",     "inherits": "test-base", "configurePreset": "linux-gcc-debug" },
    { "name": "linux-gcc-release",   "inherits": "test-base", "configurePreset": "linux-gcc-release" },
    { "name": "linux-clang-release", "inherits": "test-base", "configurePreset": "linux-clang-release" },
    { "name": "linux-gcc-asan",    "inherits": "test-base", "configurePreset": "linux-gcc-asan" }
  ]
}
